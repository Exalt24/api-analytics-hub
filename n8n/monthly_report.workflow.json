{
  "id": "hubMonthlyReport01",
  "name": "Monthly report for each tenant",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Monthly report for each tenant\nRuns on the 1st of the month at 06:00 UTC and asks the hub for last month's deck, once for each tenant in `HUB_TENANTS_JSON`. Asking twice for a month gives the same deck and sends nothing twice.\n**Needs** `N8N_BLOCK_ENV_ACCESS_IN_NODE=false` and the variables in n8n/README.md. Slack and email are **off** until `DELIVER_SLACK` or `DELIVER_EMAIL` is `true`.",
        "height": 230,
        "width": 560,
        "color": 4
      },
      "id": "010e3b1a-5c7d-4e2f-9a10-4d6f6e74686c79",
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        -260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 1 * *"
            }
          ]
        }
      },
      "id": "020e3b1a-5c7d-4e2f-9a10-4d6f6e74686c7a",
      "name": "Schedule, 1st of the month 06:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {},
      "id": "030e3b1a-5c7d-4e2f-9a10-4d6f6e74686c7b",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        160
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a-month",
              "name": "month",
              "type": "string",
              "value": "={{ $env.HUB_REPORT_MONTH || $now.minus({ months: 1 }).toFormat('yyyy-MM') }}"
            },
            {
              "id": "a-hub_url",
              "name": "hub_url",
              "type": "string",
              "value": "={{ ($env.HUB_BASE_URL || '').replace(/\\/+$/, '') }}"
            },
            {
              "id": "a-as_of",
              "name": "as_of",
              "type": "string",
              "value": "={{ $env.HUB_AS_OF || '' }}"
            },
            {
              "id": "a-slack_on",
              "name": "slack_on",
              "type": "boolean",
              "value": "={{ $env.DELIVER_SLACK === 'true' }}"
            },
            {
              "id": "a-email_on",
              "name": "email_on",
              "type": "boolean",
              "value": "={{ $env.DELIVER_EMAIL === 'true' }}"
            },
            {
              "id": "a-tenants",
              "name": "tenants",
              "type": "array",
              "value": "={{ JSON.parse($env.HUB_TENANTS_JSON) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "040e3b1a-5c7d-4e2f-9a10-4d6f6e74686c7c",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -120,
        80
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "tenants",
        "include": "allOtherFields",
        "options": {
          "destinationFieldName": "tenant"
        }
      },
      "id": "050e3b1a-5c7d-4e2f-9a10-4d6f6e74686c7d",
      "name": "One item per tenant",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        140,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.hub_url }}/api/reports/monthly",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $json.tenant.api_key }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ 'monthly-report:' + $json.tenant.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') + ':' + $json.month }}"
            },
            {
              "name": "Content-Type",
              "value": "=application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.as_of ? { month: $json.month, as_of: $json.as_of } : { month: $json.month }) }}"
      },
      "id": "060e3b1a-5c7d-4e2f-9a10-4d6f6e74686c7e",
      "name": "Build the report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        80
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-already-delivered?",
              "leftValue": "={{ $json.delivered }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
