{% comment %}
  Specification table, delivered as a THEME APP EXTENSION rather than as a theme
  section.

  WHY THAT DISTINCTION IS THE WHOLE POINT. The same feature already exists as a
  section in a theme I edited directly, and editing a merchant's theme has two
  costs they feel later. The change lives in one theme, so it is gone the moment
  they switch theme or accept an update that overwrites the file, and it makes
  their theme a fork that nobody can cleanly upgrade. An app block installs
  alongside the theme: the merchant adds it in the theme editor, it survives theme
  updates and theme switches, and uninstalling the app removes it cleanly instead
  of leaving orphaned Liquid behind.

  It is also the honest answer to "can you build a private app for us" for a
  merchant who does not want their theme touched at all.

  WHAT AN APP BLOCK CANNOT DO, stated because it shapes the design. It cannot read
  the theme's own settings or CSS variables, so it must carry its own styling and
  degrade sensibly on any theme. It renders where the merchant drops it, so it must
  make no assumption about surrounding markup. And it must render NOTHING when
  there is no data, since a merchant experimenting in the editor should never be
  left with an empty heading on a live product page.
{% endcomment %}

{%- liquid
  assign ns = product.metafields[block.settings.namespace]
-%}

{%- if ns != blank -%}
  <div class="dac-spec" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="dac-spec__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}

    <dl class="dac-spec__list">
      {%- for pair in ns -%}
        {%- liquid
          assign key = pair[0]
          assign field = pair[1]

          # false compares equal to blank in Liquid, so a boolean set to false
          # disappears unless it is allowed through explicitly. On a technical
          # catalogue that is the row that most needs to be there.
          assign renderable = false
          if field.type == 'boolean'
            assign renderable = true
          elsif field.value != blank
            assign renderable = true
          endif

          assign label_parts = key | split: '__'
          if label_parts.size > 1
            assign label = label_parts | last | replace: '_', ' ' | capitalize
          else
            assign label = key | replace: '_', ' ' | capitalize
          endif
        -%}
        {%- if renderable -%}
          <div class="dac-spec__row">
            <dt class="dac-spec__key">{{ label | escape }}</dt>
            <dd class="dac-spec__value">
              {%- case field.type -%}
                {%- when 'dimension', 'weight', 'volume' -%}
                  {{ field.value.value }} {{ field.value.unit | downcase }}
                {%- when 'rating' -%}
                  {{ field.value.value }} / {{ field.value.scale_max }}
                {%- when 'boolean' -%}
                  {% if field.value %}Yes{% else %}No{% endif %}
                {%- when 'list.single_line_text_field' -%}
                  {{ field.value | join: ', ' }}
                {%- when 'url' -%}
                  <a href="{{ field.value | escape }}" rel="nofollow">{{ field.value | escape }}</a>
                {%- else -%}
                  {{ field.value }}
              {%- endcase -%}
            </dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
  </div>

  {%- style -%}
    .dac-spec { margin: {{ block.settings.margin }}px 0; }
    .dac-spec__heading { font-size: 1.15rem; margin: 0 0 0.75rem; }
    .dac-spec__list { margin: 0; max-width: 44rem; border-top: 1px solid rgba(128,128,128,.25); }
    /* Label and value stay side by side at EVERY width. Measured on five technical
       storefronts: McMaster holds a 38/62 split at 374px. Stacking on mobile turns
       a twenty-spec table into a forty-row scroll on the device where scanning is
       hardest. */
    .dac-spec__row {
      display: grid;
      grid-template-columns: 38% 1fr;
      gap: .75rem;
      padding: .6rem 0;
      border-bottom: 1px solid rgba(128,128,128,.25);
    }
    /* The VALUE carries the contrast, not the label: the label is furniture and the
       number is what the buyer came for. An app block cannot read the theme's
       colour tokens, so currentColor is used and the label is stepped back with
       opacity, which works on a light or a dark theme without knowing which. */
    .dac-spec__key { margin: 0; font-weight: 500; opacity: .72; }
    .dac-spec__value { margin: 0; font-weight: 500; color: currentColor; }
    @media screen and (max-width: 480px) {
      .dac-spec__row { gap: .5rem; font-size: .95rem; }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Specification table",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specifications"
    },
    {
      "type": "text",
      "id": "namespace",
      "label": "Metafield namespace",
      "default": "specs",
      "info": "Every metafield in this namespace renders. Adding a spec needs no code change."
    },
    {
      "type": "range",
      "id": "margin",
      "label": "Vertical margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
