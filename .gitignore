# 432MB of reproducible artifacts. Measured, not guessed: .venv 84MB,
# web/node_modules 348MB, web/.next 73MB, 13,444 files between them.
.venv/
.venv-nix/
__pycache__/
*.pyc
web/node_modules/
web/.next/
web/out/
.vercel/

# Secrets never live in the repo. The scripts read the Shopify token and app credentials from
# the files named in app/secret_files.py, by default under .secrets/ here.
.secrets/
.env
.env.local
*.token

# Terraform: the state file holds every value it ever read, secrets included, so it and the variable files never get committed.
# The provider lock file (.terraform.lock.hcl) is committed on purpose: it pins the provider version.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
live_check_evidence.txt

# web/: Playwright output and the lint tool's own install
web/test-results/
web/playwright-report/
web/lint/node_modules/
