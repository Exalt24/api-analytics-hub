    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csv-parse": "^7.0.3",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
