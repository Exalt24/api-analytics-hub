{
  "name": "analytics-hub-web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "node lint/node_modules/eslint/bin/eslint.js --config lint/eslint.config.mjs --max-warnings 0 app components lib tests e2e live",
    "lint:install": "npm ci --prefix lint",
    "lint:test": "node --test lint/lint.test.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mutation": "node scripts/mutation_check.mjs",
    "live:model": "vitest run --config vitest.live.config.mjs"
  },
  "dependencies": {
