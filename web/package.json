    "@hookform/resolvers": "^7.0.5",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "ai": "^7.0.166",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "kysely": "^0.29.8",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
